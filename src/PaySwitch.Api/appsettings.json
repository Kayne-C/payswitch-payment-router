{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Db": "Host=localhost;Port=5432;Database=payswitch;Username=payswitch;Password=payswitch-dev-only"
  },
  "PaySwitch": {
    "Providers": [
      { "Name": "alpha", "BaseUrl": "http://localhost:5301", "FeeBps": 180, "FixedFee": 25, "Currencies": ["TRY", "EUR", "USD"] },
      { "Name": "beta", "BaseUrl": "http://localhost:5302", "FeeBps": 210, "FixedFee": 10, "Currencies": ["TRY", "EUR", "USD"] },
      { "Name": "gamma", "BaseUrl": "http://localhost:5303", "FeeBps": 290, "FixedFee": 0, "Currencies": ["TRY", "EUR"] }
    ],
    "Resilience": {
      "AttemptTimeoutMs": 2000,
      "RetryCount": 2,
      "RetryBaseDelayMs": 100,
      "BreakerFailureRatio": 0.5,
      "BreakerSamplingSeconds": 10,
      "BreakerMinimumThroughput": 10,
      "BreakerBreakSeconds": 15
    },
    "Saga": {
      "StuckAfterSeconds": 30,
      "CaptureDeadlineSeconds": 300,
      "LedgerMaxAttempts": 5,
      "RecoveryIntervalMs": 1000
    }
  }
}
